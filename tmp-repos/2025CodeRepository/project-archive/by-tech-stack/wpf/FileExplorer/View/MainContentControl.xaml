<UserControl x:Class="FileExplorer.View.MainContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FileExplorer.View" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="{DynamicResource MaterialDesignBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" Margin="10" Padding="10">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <TreeView x:Name="DirectoryTree" SelectedItemChanged="DirectoryTree_SelectedItemChanged" 
                              FontSize="14" Foreground="{DynamicResource MaterialDesignBody}" ItemsSource="{Binding Drives}" />
                </ScrollViewer>
            </materialDesign:Card>

        </Grid>
        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignBackground}">
            <ListView x:Name="FileListView" FontSize="14" Foreground="{DynamicResource MaterialDesignBody}"
                      ItemsSource="{Binding CurrentDirectoryContent}"
                      MouseDoubleClick="FileListView_MouseDoubleClick" 
                      MouseLeftButtonDown="FileListView_MouseLeftButtonUp" />
        </Grid>
        <Grid Grid.Column="2" Background="{DynamicResource MaterialDesignBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="10">
                <TextBlock Text="文件路径:" />
                <TextBlock Text="{Binding SelectedFile.FullPath}" />
                <TextBlock Text="文件大小:" />
                <TextBlock Text="{Binding SelectedFile.Size}" />
                <TextBlock Text="文件类型:" />
                <TextBlock Text="{Binding SelectedFile.Type}" />
            </StackPanel>
            <Grid Grid.Row="1" Background="AliceBlue" />
        </Grid>
    </Grid>
</UserControl>